{
  "manifest_version": 3,
  "name": "Virtual Gamepad",
  "version": "0.1.0",
  "description": "Use your phone as a controller for Xbox Cloud Gaming.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Virtual Gamepad",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.xbox.com/*/play*", "https://play.xbox.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.xbox.com/*/play*", "https://play.xbox.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
