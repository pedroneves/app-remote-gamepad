{
  "name": "@remote-gamepad/server",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "build:macos-arm64": "deno compile --target aarch64-apple-darwin --include ../../web-app/dist --allow-net=0.0.0.0 --allow-sys=networkInterfaces --allow-read=../../web-app/dist --output dist/remote-gamepad-server-macos-arm64 src/main.ts",
    "build:linux-arm64": "deno compile --target aarch64-unknown-linux-gnu --include ../../web-app/dist --allow-net=0.0.0.0 --allow-sys=networkInterfaces --allow-read=../../web-app/dist --output dist/remote-gamepad-server-linux-arm64 src/main.ts",
    "build": "deno task build:macos-arm64 && deno task build:linux-arm64"
  }
}
